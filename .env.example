# Ventzon — environment variables (example)
#
# Copy this file to .env.local and fill in real values. Secrets live only in
# .env.local / Vercel and are never committed.
#
# The two Stripe price IDs below are the ONLY source of truth for the Ventzon
# Pro subscription price (see src/lib/pricing.ts). They are NEXT_PUBLIC_ and
# inlined at build time, so any change requires a redeploy.
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=price_replace_with_monthly_price_id
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=price_replace_with_yearly_price_id
